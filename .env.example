# Copy to .env and fill in. Never commit .env. Variable names are part of the contract: do not rename them.

# --- Database (one login role per service; dev passwords are placeholders) ---
POSTGRES_PORT=5432
POSTGRES_PASSWORD=postgres
INGEST_DATABASE_URL=postgresql://ingest_svc:dev_only_change_me@localhost:5432/platform
RUNS_DATABASE_URL=postgresql://runs_svc:dev_only_change_me@localhost:5432/platform
ERP_DATABASE_URL=postgresql://erp_svc:dev_only_change_me@localhost:5432/platform
EVAL_DATABASE_URL=postgresql://eval_svc:dev_only_change_me@localhost:5432/platform

# --- Queue and cache ---
VALKEY_URL=redis://localhost:6379/0

# --- Models (names differ per laptop depending on RAM; keep them in env, never hardcode) ---
OLLAMA_HOST=http://localhost:11434
LLM_MODEL_NAME=
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# --- Service URLs ---
INGEST_SERVICE_URL=http://localhost:8000
RUNS_SERVICE_URL=http://localhost:8001
MOCK_ERP_URL=http://localhost:8002
MCP_ERP_URL=http://localhost:8010
MCP_POLICY_URL=http://localhost:8011

# --- Auth: RS256. Only the ingest service reads the private key; every other service reads the public key. ---
JWT_ISSUER=ingest
JWT_PRIVATE_KEY_PATH=.dev-keys/private.pem
JWT_PUBLIC_KEY_PATH=.dev-keys/public.pem

# --- Multi-tenancy (development tenants) ---
DEFAULT_TENANT_ID=11111111-1111-4111-8111-111111111111
